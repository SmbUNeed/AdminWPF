<Window x:Class="AdminWPF.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdminWPF" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <DockPanel>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="12,8,12,0"
    Style="{StaticResource GhostButton}" Content="Сменить тему" Click="ThemeButton_Click"/>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
           Background="{DynamicResource BackgroundBrush}"
           Foreground="{DynamicResource ForegroundBrush}"/>
    </DockPanel>
</Window>
