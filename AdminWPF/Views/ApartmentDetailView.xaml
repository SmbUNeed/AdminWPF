<UserControl x:Class="AdminWPF.Views.ApartmentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminWPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="10">
        <Button x:Name="SaveButton" Content="Сохранить" DockPanel.Dock="Bottom" Height="32" Margin="0,10,0,0"/>
        <TabControl>
            <TabItem Header="Описание">
                <StackPanel Margin="10">
                    <TextBox x:Name="TitleBox" Margin="0,0,0,8"/>
                    <TextBox x:Name="AddressBox" Margin="0,0,0,8"/>
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="AmenitiesTabItem" Header="Удобства"/>
            <TabItem x:Name="RulesTabItem" Header="Правила"/>
            <TabItem x:Name="NearbyTabItem" Header="Рядом"/>
        </TabControl>
    </DockPanel>
</UserControl>
