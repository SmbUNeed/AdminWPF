<Page x:Class="AdminWPF.Views.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        CornerRadius="20" Padding="40" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="SutkiVMV" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Вход в админку" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>
            <TextBlock Text="Логин" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" FontSize="15"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,12"/>
            <TextBlock Text="Пароль" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" FontSize="15"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>
            <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" Margin="0,0,0,10"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Page>