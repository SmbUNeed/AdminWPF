<Page x:Class="AdminWPF.Views.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход">
    <StackPanel Margin="30" VerticalAlignment="Center" MaxWidth="320">
        <TextBlock Text="Вход в AdminWPF" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="EmailBox" Padding="6,0" Margin="0,0,0,12"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Padding="6,0" Margin="0,0,0,20"/>
        <Button x:Name="LoginButton" Content="Войти" Height="34" Click="LoginButton_Click" Margin="0,0,0,10"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Visibility="Collapsed"/>
    </StackPanel>
</Page>