<Window x:Class="AdminWPF.Windows.Captcha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminWPF.Windows"
        mc:Ignorable="d"
        Title="Captcha" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="ErrorText"/>
            <TextBlock x:Name="CapchaTB"/>
            <TextBox x:Name="CapchaEnter"/>
            <Button Content="Пройти" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>